{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AvScanner",
  "version": "0.1.0",
  "identifier": "com.av.scanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420"
  },
  "plugins": {
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true
    },
    "shell": {
      "open": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AvScanner",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}